{
  "label": "smac_terran5_pilot20k",
  "scope": "20k-step feedforward SMACv2 development throughput/learning pilot,terran5v5,seed0,eight evaluation episodes. Not a10M benchmark result.",
  "seeds": [
    0
  ],
  "base_config": {
    "environment": "smac",
    "env_config": {
      "scenario": "terran_5v5"
    },
    "steps": 20000,
    "num_envs": 2,
    "rollout_steps": 128,
    "hidden_dim": 64,
    "epochs": 5,
    "learning_rate": 0.0005,
    "modifier_learning_rate": 5e-05,
    "critic_learning_rate": 0.0005,
    "entropy_coef": 0.01,
    "max_grad_norm": 10.0,
    "normalize_value_targets": true,
    "value_clip_coef": 0.2,
    "value_huber_delta": 10.0,
    "eval_episodes": 8,
    "eval_every_steps": 10000,
    "checkpoint_every_updates": 25,
    "threads": 1
  },
  "variants": {
    "mappo": {
      "algorithm": "mappo"
    },
    "arppo": {
      "algorithm": "arppo"
    },
    "bppo": {
      "algorithm": "bppo"
    },
    "agentmixer": {
      "algorithm": "agentmixer"
    },
    "agentmixer_identity": {
      "algorithm": "agentmixer",
      "modifier_enabled": false
    }
  }
}
